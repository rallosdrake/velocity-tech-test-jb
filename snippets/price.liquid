{%- if item.compare_at_price > item.price -%}
  <span class="Price Price--sale">
    <span class="Price__Current">
      {{ item.price | money }}
    </span>
    <span class="Price__Compare">
      {{ item.compare_at_price | money }}
    </span>
  </span>
{%- else -%}
  <span class="Price">
    {{ item.price | money }}
  </span>
{%- endif -%}
